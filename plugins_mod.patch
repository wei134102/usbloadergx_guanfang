+	bgImg = new GuiImage(bgImgData);
+	Append(bgImg);
+
+	width = bgImg->GetWidth();
+	height = bgImg->GetHeight();
+
+	titleTxt = new GuiText(tr("Select Plugin"), 30, thColor("r=0 g=0 b=0 a=255 - plugin prompt title text color"));
