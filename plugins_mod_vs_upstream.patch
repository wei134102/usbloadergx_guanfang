+	// 游戏列表缓存：主列表（合并后）
+	vector<discHdr*> pluginsGameList;
+
+	// Per-plugin 缓存：key = magic（十六进制字符串如 "4D414D57"）
+	map<string, PluginGameCache> perPluginCache;
+
+	// 辅助：将 magic（u32）转为 8 位十六进制字符串 key
+	string magicToKey(u32 magic);
